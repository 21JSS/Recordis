{
  "expo": {
    "name": "Recordis",
    "slug": "Recordis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Recordis-icon-app.png",
    "scheme": "recordis",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A1C",
        "foregroundImage": "./assets/images/Recordis-icon-app.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.Recordis"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Recordis-icon-app.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080816",
          "image": "./assets/images/Recordis-icon-app.png",
          "imageWidth": 100
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "799b5f6d-5ae1-48c2-9777-6f7c3143632b"
      }
    }
  }
}
